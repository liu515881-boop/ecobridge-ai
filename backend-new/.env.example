# ============================================
# EcoBridge AI Backend 环境变量配置
# ============================================

# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecobridge
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT 配置
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# 阿里云百炼 API 配置
DASHSCOPE_API_KEY=sk-your-api-key-here
QWEN_VL_MODEL=qwen-vl-max-latest

# 文件上传配置
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# OSS 存储配置（可选，用于生产环境）
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# 日志配置
LOG_LEVEL=info
